{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:jornada:038:library:v1",
  "title":"definition.json do pacote jcomp v1",
  "description":"maxLength conta pontos de código Unicode válidos; bytes UTF-8 de frames e pacotes são limites independentes. Rejeitar Unicode inválido sem truncar ou normalizar.",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","definitionId","version","name","description","category","source","templateSha256","requirements","parameters"],
  "properties":{
    "schemaVersion":{"const":1},
    "definitionId":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "version":{"type":"string","maxLength":64,"pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "name":{"type":"string","minLength":1,"maxLength":256},
    "description":{"type":"string","maxLength":4096},
    "category":{"enum":["composition","variant"]},
    "source":{"type":"object","additionalProperties":false,"required":["description","files"],"properties":{"description":{"type":"string","maxLength":4096},"files":{"type":"array","maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["reference","sha256"],"properties":{"reference":{"type":"string","minLength":1,"maxLength":512},"sha256":{"$ref":"#/$defs/Hash"}}}}}},
    "templateSha256":{"$ref":"#/$defs/Hash"},
    "requirements":{"type":"object","additionalProperties":false,"required":["catalogVersions","kinds","installedResources"],"properties":{"catalogVersions":{"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":4}},"kinds":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"enum":["button","label","title","textField","radio","report","numericKeyboard","barcodeInput","barcodeProcessed","applicationMenu"]}},"installedResources":{"type":"array","maxItems":512,"items":{"type":"object","additionalProperties":false,"required":["role","name","path","sha256"],"properties":{"role":{"enum":["skinImage","font"]},"name":{"type":"string","minLength":1,"maxLength":256},"path":{"type":"string","minLength":1,"maxLength":512},"sha256":{"$ref":"#/$defs/Hash"}}}}}},
    "parameters":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/Parameter"}}
  },
  "$defs":{
    "Hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Parameter":{"type":"object","additionalProperties":false,"required":["name","type","required","bindings"],"properties":{"name":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]{0,63}$"},"type":{"enum":["string","boolean"]},"required":{"type":"boolean"},"defaultValue":{"type":["string","boolean"],"maxLength":65536},"bindings":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["componentId","property"],"properties":{"componentId":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"property":{"enum":["text","initialValue","buttonVariant","fieldFormat","enabled"]}}}}},"allOf":[{"if":{"properties":{"type":{"const":"boolean"}}},"then":{"properties":{"defaultValue":{"type":"boolean"}}},"else":{"properties":{"defaultValue":{"type":"string","maxLength":65536}}}}]}
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:jornada:038:proposal:v1",
  "title":"Proposta estruturada do agente externo",
  "description":"maxLength conta pontos de código Unicode válidos. Defaults observados são alegações ligadas a evidências; estrutura válida não significa autorização ou homologação. Referências de evidência, enum e contratos instalados exigem validação semântica adicional.",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","proposalId","revision","name","objective","classification","materialization","evidence","observations","hypotheses","properties","visualStates","behaviors","dependencies","reusableCapabilities","missingCapabilities","differences","validationPlan"],
  "properties":{
    "schemaVersion":{"const":1},
    "proposalId":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "revision":{"type":"integer","minimum":1,"maximum":2147483647},
    "name":{"type":"string","minLength":1,"maxLength":256},
    "objective":{"type":"string","minLength":1,"maxLength":4096},
    "classification":{"enum":["composition","variant","newKind"]},
    "materialization":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/Materialization"}]},
    "evidence":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["evidenceId","materialId","sha256","locator"],"properties":{"evidenceId":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},"materialId":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"locator":{"type":"string","maxLength":512}}}},
    "observations":{"type":"array","maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["statement","evidenceRefs"],"properties":{"statement":{"type":"string","minLength":1,"maxLength":4096},"evidenceRefs":{"type":"array","minItems":1,"maxItems":256,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"}}}}},
    "hypotheses":{"$ref":"#/$defs/Statements"},
    "properties":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/PropertyDescriptor"}},
    "visualStates":{"$ref":"#/$defs/Statements"},
    "behaviors":{"$ref":"#/$defs/Statements"},
    "dependencies":{"$ref":"#/$defs/Statements"},
    "reusableCapabilities":{"$ref":"#/$defs/Statements"},
    "missingCapabilities":{"$ref":"#/$defs/Statements"},
    "differences":{"$ref":"#/$defs/Statements"},
    "validationPlan":{"$ref":"#/$defs/Statements"}
  },
  "allOf":[{"if":{"properties":{"classification":{"const":"newKind"}}},"then":{"properties":{"materialization":{"type":"null"}}}}],
  "$defs":{
    "Materialization":{"type":"object","additionalProperties":false,"required":["captureProposalId","captureRevision","templateSha256"],"properties":{"captureProposalId":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"captureRevision":{"type":"integer","minimum":1,"maximum":2147483647},"templateSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "Statements":{"type":"array","maxItems":256,"items":{"type":"string","minLength":1,"maxLength":4096}},
    "EvidenceRefs":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"}},
    "LogicalReference":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "DefaultDescriptor":{
      "type":"object","additionalProperties":false,
      "required":["status"],
      "properties":{
        "status":{"enum":["unknown","observed","proposed"]},
        "value":{"type":["string","integer","boolean","array"],"maxLength":65536,"minimum":-9007199254740991,"maximum":9007199254740991,"maxItems":256,"items":{"type":["string","integer","boolean"],"maxLength":65536,"minimum":-9007199254740991,"maximum":9007199254740991}},
        "evidenceRefs":{"$ref":"#/$defs/EvidenceRefs"},
        "reason":{"type":"string","minLength":1,"maxLength":4096}
      },
      "allOf":[
        {"if":{"properties":{"status":{"const":"unknown"}}},"then":{"required":["reason"],"properties":{"value":false}}},
        {"if":{"properties":{"status":{"const":"observed"}}},"then":{"required":["value","evidenceRefs"],"properties":{"evidenceRefs":{"minItems":1}}}},
        {"if":{"properties":{"status":{"const":"proposed"}}},"then":{"required":["value","reason"]}}
      ]
    },
    "PropertyDescriptor":{
      "type":"object","additionalProperties":false,
      "required":["name","type","description","default"],
      "properties":{
        "name":{"type":"string","minLength":1,"maxLength":128},
        "type":{"enum":["string","integer","boolean","enum","collection","reference"]},
        "description":{"type":"string","maxLength":4096},
        "default":{"$ref":"#/$defs/DefaultDescriptor"},
        "enumValues":{"type":"array","minItems":1,"maxItems":256,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
        "itemType":{"enum":["string","integer","boolean","reference"]}
      },
      "allOf":[
        {"if":{"properties":{"type":{"enum":["string","enum"]}}},"then":{"properties":{"default":{"properties":{"value":{"type":"string","maxLength":65536}}}}}},
        {"if":{"properties":{"type":{"const":"integer"}}},"then":{"properties":{"default":{"properties":{"value":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}}}}}},
        {"if":{"properties":{"type":{"const":"boolean"}}},"then":{"properties":{"default":{"properties":{"value":{"type":"boolean"}}}}}},
        {"if":{"properties":{"type":{"const":"reference"}}},"then":{"properties":{"default":{"properties":{"value":{"$ref":"#/$defs/LogicalReference"}}}}}},
        {"if":{"properties":{"type":{"const":"enum"}}},"then":{"required":["enumValues"]},"else":{"properties":{"enumValues":false}}},
        {"if":{"properties":{"type":{"const":"collection"}}},"then":{"required":["itemType"],"properties":{"default":{"properties":{"value":{"type":"array","maxItems":256}}}}},"else":{"properties":{"itemType":false}}},
        {"if":{"required":["itemType"],"properties":{"itemType":{"const":"string"}}},"then":{"properties":{"default":{"properties":{"value":{"items":{"type":"string","maxLength":65536}}}}}}},
        {"if":{"required":["itemType"],"properties":{"itemType":{"const":"integer"}}},"then":{"properties":{"default":{"properties":{"value":{"items":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}}}}}}},
        {"if":{"required":["itemType"],"properties":{"itemType":{"const":"boolean"}}},"then":{"properties":{"default":{"properties":{"value":{"items":{"type":"boolean"}}}}}}},
        {"if":{"required":["itemType"],"properties":{"itemType":{"const":"reference"}}},"then":{"properties":{"default":{"properties":{"value":{"items":{"$ref":"#/$defs/LogicalReference"}}}}}}}
      ]
    }
  }
}

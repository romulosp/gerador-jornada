{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Jornada Studio: compilar Windows",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-File",
                "${workspaceFolder}/apps/gerador-jornada/scripts/build.ps1",
                "-OutputDirectory",
                "${workspaceFolder}/apps/gerador-jornada/dist/windows-amd64"
            ],
            "options": {
                "cwd": "${workspaceFolder}/apps/gerador-jornada"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}